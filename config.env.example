# ios-auto-deploy config. Copy to ~/Library/Application Support/IOSAutoDeploy/config.env
# (install.sh does this). Every key is optional; these are the defaults.

# Folder scanned for projects; a project takes part when it contains an ios-deploy.conf.
PROJECTS_ROOT=~/Documents/agent-coding

# iPhone UDID (xcrun devicectl list devices). Empty = the only paired physical iPhone.
DEVICE_UDID=

# How often to look for new commits.
POLL_SECONDS=120

# If the app is running on the phone (also when merely suspended in the background), wait up to
# this long for it to go away before installing over it anyway. Installing kills the running app.
DEFER_RUNNING_MINUTES=120

# Optional: push a phone notification after each install (or failed build) via ntfy.
# Anyone who knows the topic can read it; use a long random string.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

BUILD_TIMEOUT_MINUTES=40
